{
    "local_addr": ":9999",
    "target": "http://127.0.0.1:2323",
    "log_file": "",
    "log_level": "error",
    "allow_auth": true,
    "cache_unique": true,
    "cache_mobile": true,
    "cache_size": "400m",
    "cache_status": [200, 301],
    "non_get_mode": "pass",
    "lfu_time": "60m",
    "protection_expire": "30m",
    "idle_timeout": "5s",
    "read_timeout": "2s",
    "write_timeout": "2s",
    "target_timeout": "5s",
    "target_rate_limit": [50, 10],
    "refresh_header": "X-Cache-Update",
    "refresh_password": "true",
    "cli_socket": "/tmp/minicache.sock"
}